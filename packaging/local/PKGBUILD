# Maintainer: Kestrel <https://github.com/kestrel-distro>
#
# Lean Quickshell build for Kestrel, built from this fork's own tree. Clang,
# ThinLTO, x86-64-v3, with the optional modules the Kestrel shell does not use
# disabled.
#
# The package is named quickshell-kestrel and conflicts/replaces/provides the
# Arch package, so Arch's stock quickshell can never install or overwrite it.
# Updates come only from the Kestrel [kestrel] repository. The installed binary
# and library are unchanged.
#
# Disabled modules are verified against kestrel/shell: the shell imports
# Bluetooth, Networking, Mpris, Notifications, Pam, Pipewire, Polkit,
# SystemTray, UPower, Hyprland, Wayland (SessionLock, ToplevelManager) and
# Quickshell.Io. It does NOT use X11, I3, Screencopy or Greetd, so those are
# off. Screenshots go through grim + slurp, not Quickshell screencopy.
#
# Build options:
#   _kestrel_march   x86-64-v3 (default); x86-64-v4 or native to retarget
#   _kestrel_lto     thin (default) | none

pkgname=quickshell-kestrel
pkgver=0.3.2
pkgrel=1
pkgdesc='Flexible toolkit for making desktop shells with QtQuick'
arch=(x86_64)
url="https://git.outfoxxed.me/quickshell/quickshell"
license=(LGPL-3.0-only)
depends=(cpptrace libcpptrace.so
         glibc # libc.so libm.so
         hicolor-icon-theme
         jemalloc libjemalloc.so
         libdrm # libdrm.so
         libgcc libgcc_s.so
         libglvnd libEGL.so libOpenGL.so
         libpipewire libpipewire-0.3.so
         libstdc++ libstdc++.so
         libxcb # libxcb.so
         mesa # libgbm.so
         pam libpam.so
         polkit
         qt6-base # libQt6Core.so libQt6DBus.so libQt6Gui.so libQt6Network.so libQt6Widgets.so
         qt6-declarative # libQt6Qml.so libQt6Quick.so
         qt6-svg
         qt6-wayland # libQt6WaylandClient.so
         wayland libwayland-client.so)
makedepends=(cli11
             clang
             cmake
             lld
             llvm
             mold
             ninja
             qt6-shadertools
             spirv-tools
             vulkan-headers
             wayland-protocols)
provides=(quickshell)
conflicts=(quickshell)
replaces=(quickshell)
options=(!debug)

: "${_kestrel_march:=x86-64-v3}"
: "${_kestrel_lto:=thin}"
# PGO: "no" (default), "generate" for the instrumented pass, or "use" for the
# optimized pass against a profile directory. Two-stage; see packaging/PGO.md.
: "${_kestrel_pgo:=no}"
: "${_kestrel_pgo_dir:=/tmp/quickshell.profdata}"

source=("quickshell::git+https://github.com/kestrel-distro/quickshell.git")
sha256sums=('SKIP')

pkgver() {
	cd quickshell
	git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd quickshell
	# Clang's -mtune rejects x86-64-v3; -march alone targets the baseline.
	local _cflags="-march=${_kestrel_march}"
	local _ldflags=""
	if [[ "$_kestrel_lto" == "thin" ]]; then
		_cflags+=" -flto=thin"
		_ldflags+=" -flto=thin -fuse-ld=mold"
	fi
	case "$_kestrel_pgo" in
		no) ;;
		generate)
			_cflags+=" -fprofile-generate=$_kestrel_pgo_dir"
			_ldflags+=" -fprofile-generate=$_kestrel_pgo_dir"
			;;
		use)
			_cflags+=" -fprofile-use=$_kestrel_pgo_dir -fprofile-correction"
			_ldflags+=" -fprofile-use=$_kestrel_pgo_dir"
			;;
		*) error "invalid _kestrel_pgo: $_kestrel_pgo (no|generate|use)" ;;
	esac
	local _cmake=(
		-G Ninja -B build -W no-dev
		-DCMAKE_BUILD_TYPE=Release
		-DCMAKE_INSTALL_PREFIX=/usr
		-DINSTALL_QML_PREFIX=lib/qt6/qml
		-DDISTRIBUTOR=Kestrel
		-DCRASH_HANDLER=OFF
		-DNO_PCH=ON
		-DX11=OFF
		-DI3=OFF
		-DSCREENCOPY=OFF
		-DSERVICE_GREETD=OFF
		-DCMAKE_C_COMPILER=clang
		-DCMAKE_CXX_COMPILER=clang++
		-DCMAKE_C_FLAGS="$_cflags"
		-DCMAKE_CXX_FLAGS="$_cflags"
		-DCMAKE_EXE_LINKER_FLAGS="$_ldflags"
		-DCMAKE_SHARED_LINKER_FLAGS="$_ldflags"
	)
	if [[ "$_kestrel_lto" == "thin" ]]; then
		_cmake+=(-DCMAKE_AR="$(command -v llvm-ar)" -DCMAKE_RANLIB="$(command -v llvm-ranlib)" -DCMAKE_NM="$(command -v llvm-nm)")
	fi
	cmake "${_cmake[@]}"
	cmake --build build
}

package() {
	cd quickshell
	DESTDIR="$pkgdir" cmake --install build
	install -Dm0644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
